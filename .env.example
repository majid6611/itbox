# Copy to .env and fill in real values before running docker compose up.

POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# Hostname (without scheme) the platform is reached at, and the base every
# module gets a subdomain under (e.g. hello-world.${BASE_DOMAIN}). For local
# testing, "localhost" works with no /etc/hosts changes since browsers/OSes
# auto-resolve *.localhost to 127.0.0.1. In production, set this to your
# real domain (e.g. it.company.com) and point DNS/a wildcard record at it.
BASE_DOMAIN=localhost

# First-boot admin account. Only used to seed the first admin_users row;
# ignored once one exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
